{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "caseSensitive": true,
  "dictionaries": ["en-gb", "project-words", "user-words"],
  "enabledLanguageIds": ["markdown", "plaintext"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    },
    {
      "name": "user-words",
      "path": "~/.cspell/user-words.txt",
      "addWords": true
    }
  ],  
  "ignorePaths": [
    "node_modules",
    "blib",
    "_build",
    "cdk.out"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "locale": "en-GB"
    }
  ],
  "overrides": [
    {
      "filename": "**/Fan Fiction/Hope/**/*.md",
      "language": "en-GB,fr",
      "dictionaries": ["en-gb", "fr-fr", "project-words", "user-words"]
    }
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"]
}
