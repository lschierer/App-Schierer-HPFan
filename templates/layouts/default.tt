[% #cspell: disable %]
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="stylesheet" href="/css/global.css" />

    [% IF css_files -%]
      [% FOREACH css_file IN css_files -%]
        <link rel="stylesheet" href="[% css_file %]" />
      [% END -%]
    [% END -%]

    <title>[% title || "Luke\'s HP Site" %]</title>

    <script type="module" src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
    [%# Registers the gen2 and site custom elements; see lib/swc.ts. -%]
    <script type="module" src="/js/lib/swc.js"></script>
    <!-- Google tag (gtag.js) -->
    

  </head>
  [% sidebar = sidebar.defined ? sidebar : 1 -%]
  <body[% IF sidebar %] class="with-sidebar"[% END %]>
    [% INCLUDE partials/global_header.tt %]
    [% IF sidebar -%]
      <div class="title-section">
        <h1 class="swc-Heading swc-Heading--sizeXXL">
          [% heading || title %]
        </h1>
      </div>
      [%# The start pane holds the contextual tree, the end pane the page. <site-tree> moves
          the tree into the mobile drawer below 768px (partials/mobile_navigation.tt);
          <site-split-view> makes the splitter draggable. Both are plain boxes until
          /js/lib/swc.js has run. -%]
      <site-split-view storage-key="pagi:nav-width" label="Resize navigation sidebar">
        <div id="nav" slot="start">
          <site-tree mobile-socket="mobile-nav-tree">
            <nav class="navigation-tree">
              [% IF nav_html -%]
                [% nav_html %]
              [% ELSE -%]
                <!-- No navigation configured -->
              [% END -%]
            </nav>
          </site-tree>
        </div>
        <div slot="splitter" aria-hidden="true"></div>
        <div id="main" slot="end">
    [% END -%]

    <main class="[% sidebar ? 'with-sidebar' : 'no-sidebar' %]">
      [% content %]
    </main>

    [% IF sidebar -%]
        </div> <!-- close #main -->
      </site-split-view>
    [% END -%]

    [% IF js_files -%]
      [% FOREACH js_file IN js_files -%]
        <script type="module" src="[% js_file %]"></script>
      [% END -%]
    [% END -%]
    [% INCLUDE partials/global_footer.tt %]
  </body>
</html>
