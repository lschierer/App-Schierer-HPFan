[% WRAPPER layouts/default.tt %]
<article>
  [% IF comments %]
    [% comments %]
  [% END %]

  [% IF items.size > 0 %]
    <dl class="bookmark-items">
      [% FOREACH item IN items %]
        <dt class="swc-Heading swc-Heading--sizeM">
          [% IF item.title.link %]
            <a class="swc-Link swc-Link--quiet swc-Link--standalone" href="[% item.title.link %]">
          [% END %]
            <cite>
              [% item.title.name %]
            </cite>
          [% IF item.title.link %]
            </a>
          [% END %]
        </dt>
        <dd>
          <span class="swc-Detail swc-Detail--sizeM">Author: </span>
          [% IF item.author.link %]
            <a class="swc-Link" href="[% item.author.link %]">
          [% END %]
            <span class="swc-Body swc-Body--serif swc-Body--sizeXS">
              [% item.author.name %]
            </span>
          [% IF item.author.link %]
            </a>
          [% END %]
        </dd>
        <dd>
          [% date_labels = {
              series_start => 'Series Start',
              published    => 'Published',
              updated      => 'Updated',
              completed    => 'Completed'
          } %]
          <span class="swc-Detail swc-Detail--sizeM">Date(s): </span><br/>
          <ul class="dateList">
            [% FOREACH date_type IN ['series_start', 'published', 'updated', 'completed'] %]
              [% IF item.dates.$date_type %]
                <li class="swc-Detail swc-Detail--sizeM">
                  <strong>[% date_labels.$date_type %]:</strong>
                  <span>[% item.dates.$date_type || 'N/A' %]</span>
                </li>
              [% END %]
            [% END %]
          </ul>
        </dd>
        <dd>
          <span class="swc-Detail swc-Detail--sizeM">Comments: </span>
          [% item.comments_html %]
        </dd>
      [% END %]
    </dl>
  [% ELSE %]
    <!-- No Items Present -->
  [% END %]
</article>
[% END %]
