[% WRAPPER layouts/default.tt %]
<site-callout class="banner" variant="info" role="note">
  <div class="callout-row">
    <iconify-icon icon="octicon:info-16"></iconify-icon>
    <p>
      Note that the tool creating this timeline fills in unknown fields
      in dates. Dates that have had fields filled in are marked as '(Estimated)'.
    </p>
  </div>
</site-callout>

<section class="timeline">
  [% IF loading %]
    <!-- TIMELINE_PLACEHOLDER -->
    <div id="loading-placeholder" class="timeline-card">
      <div style="text-align: center; padding: 2rem;">
        <iconify-icon icon="line-md:loading-loop" width="48"></iconify-icon>
        <p>Loading timeline data...</p>
      </div>
    </div>
  [% ELSIF svg %]
    <div class="timeline-card">
      [% svg %]
    </div>
    <div class="footnotes">
      <ol>
      [% FOREACH key IN footnotes.keys.sort %]
        <li id="footnotes-[% key %]">
          [% FOREACH line IN footnotes.$key %]
            [% IF line AND line.length %]
              [% line %]
            [% ELSE %]
              <!-- No citation -->
              Citation Needed.
            [% END %]
          [% END %]
          <a
            href="#return-[% key %]"
            class="swc-Link" >
            <span class="swc-Body swc-Body--sizeS">
              Return to Timeline
              <iconify-icon icon="icon-park-outline:return" class="return" width="none"></iconify-icon>
            </span>
          </a>
        </li>
      [% END %]
      </ol>
    </div>
  [% ELSE %]
    <p>No events available to display.</p>
  [% END %]
</section>
[% END %]
