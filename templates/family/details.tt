[% WRAPPER layouts/default.tt %]
[% IF is_unknown -%]
<swc-card class="family-summary">
  <span slot="title">Genealogical Gaps</span>
  <span slot="description">
    This page lists [% member_count %] people with unknown or missing surname information.
    These individuals need additional research to complete their genealogical records.
  </span>
</swc-card>
[% ELSE -%]
<swc-card class="family-summary">
  <span slot="title">[% surname %] Family</span>
  <span slot="description">
    [% member_count %] [% member_count == 1 ? 'person' : 'people' %] with the surname [% surname %].
  </span>
</swc-card>
[% END -%]

<h2 class="swc-Heading swc-Heading--serif swc-Heading--heavy swc-Heading--sizeXL">Family Members</h2>

[%# The family tree: the same disclosure-tree markup as the sidebar navigation (see
    styles/navigation.css and lib/components/site-tree.ts), with a gender icon and the life
    dates on each row. Everyone starts expanded.

    `path` is what makes the ids unique: a person can appear more than once in the tree
    (as a descendant on each side of a marriage), so an id from the person would repeat. -%]
[% BLOCK render_person_node -%]
  [% has_children = children.size > 0 -%]
  [% gender_class = person.gender == 'M' ? 'is-male' : person.gender == 'F' ? 'is-female' : '' -%]
  [% icon_class = person.gender == 'M' ? 'color-male' : person.gender == 'F' ? 'color-female' : 'icon1' -%]
  [% icon_name = person.gender == 'M' ? 'ion-male' : person.gender == 'F' ? 'ion-female' : 'tdesign:user-unknown' -%]
  <li>
    <div class="site-tree-row">
      [% IF has_children -%]
        <button type="button" class="site-tree-toggle" aria-expanded="true"
                aria-controls="family-[% path %]-children"
                aria-label="Toggle descendants of [% person.display_name | html %]"></button>
      [% ELSE -%]
        <span class="site-tree-toggle site-tree-leaf" aria-hidden="true"></span>
      [% END -%]
      <span class="family-person [% gender_class %]">
        <iconify-icon icon="[% icon_name %]" class="[% icon_class %]" width="1em" height="1em"></iconify-icon>
        [% IF person.link -%]
          <a href="[% person.link %]" class="family-person-link">
        [% ELSE -%]
          <span class="family-person-link">
        [% END -%]
          <span class="person-name">[% person.display_name %]</span>
          [% IF person.birth_date || person.death_date -%]
            <span class="person-dates">
              ( [% person.birth_date || 'Unknown' %] — [% person.death_date || 'Unknown' %] )
            </span>
          [% END -%]
        [% IF person.link %]</a>[% ELSE %]</span>[% END %]
      </span>
    </div>
    [% IF has_children -%]
      <ul class="site-tree-list" id="family-[% path %]-children">
        [% FOREACH child IN children -%]
          [% INCLUDE render_person_node person=child.person children=child.children path="$path-$loop.index" -%]
        [% END -%]
      </ul>
    [% END -%]
  </li>
[% END -%]

<site-tree>
  <div class="family-tree-container">
    [% IF family_tree.size > 0 -%]
      <ul class="site-tree-list">
        [% FOREACH root IN family_tree -%]
          [% INCLUDE render_person_node person=root.person children=root.children path="r$loop.index" -%]
        [% END -%]
      </ul>
    [% ELSE -%]
      <p class="swc-Body swc-Body--sizeM">No family members found.</p>
    [% END -%]
  </div>
</site-tree>

[% IF static_content -%]
  <swc-divider size="m"></swc-divider>
  <h2 class="swc-Heading swc-Heading--serif swc-Heading--heavy swc-Heading--sizeXL">Additional Information</h2>
  [% static_content %]
[% END -%]

[% END %]
