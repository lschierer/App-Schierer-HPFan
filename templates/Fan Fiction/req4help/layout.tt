<!DOCTYPE html>
<!-- req4help layout -->
<!-- cspell: disable -->
<html lang="en" class="spectrum spectrum--medium spectrum--light light-theme light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/spectrum-overrides.css" />

    [% IF css_files -%]
      [% FOREACH css_file IN css_files -%]
        <link rel="stylesheet" href="[% css_file %]" />
      [% END -%]
    [% END -%]

    <title>[% title || 'Luke\'s HP Site' %]</title>

    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@3.0.0/dist/iconify-icon.min.js"></script>
    <!-- Google tag (gtag.js) -->
    

  </head>
  [% sidebar = sidebar.defined ? sidebar : 1 -%]
  [% classes = sidebar ? 'spectrum spectrum--medium spectrum--light spectrum-Typography light-theme light with-sidebar' : 'spectrum spectrum--medium spectrum--light spectrum-Typography light-theme light' -%]
  <body class="[% classes %]">
    [% INCLUDE partials/global_header.tt %]
    [% IF sidebar -%]
      <div class="title-section">
        <h1 class="spectrum-Heading spectrum-Heading--sizeXXL">
          Harry Potter and the Request for Help
        </h1>
      </div>
      <div class="spectrum-SplitView spectrum-SplitView--horizontal">
        <div id="nav" class="spectrum-SplitView-pane">
          <div class="spectrum-Site-sideBar">
            <nav class="navigation-tree">
              [% IF nav_html -%]
                [% nav_html %]
              [% ELSE -%]
                <!-- No navigation configured -->
              [% END -%]
            </nav>
          </div>
        </div>
        <div tabindex="0" class="spectrum-SplitView-splitter"></div>
        <div id="main" class="spectrum-SplitView-pane">
    [% END -%]

    <main class="[% sidebar ? 'with-sidebar' : 'no-sidebar' %]">
      [% content %]
      [% IF entries && entries.size > 0 %]
        <hr role="separator" class="spectrum-Divider spectrum-Divider--sizeM" />
        <div class="directory-index">
          [% INCLUDE partials/autoindex_list.tt entries=entries %]
        </div>
      [% END %]
      <div class="copyright">
        <span class="spectrum-Detail spectrum-Detail--sizeM">
          This is a fan fiction work based off of, but not associated with Mrs. J.K. Rowling, Warner Bros., or any of the individuals or companies associated with producing and publishing Harry Potter books and films.
          Only original content, derived ideas, new non-canonical characters and situations are copyright [% content.author || 'Luke Schierer' %].
        </span>
      </div>
    </main>

    [% IF sidebar -%]
        </div> <!-- close the Right spectrum-SplitView-pane -->
      </div> <!-- close the spectrum-SplitView spectrum-SplitView--horizontal -->
    [% END -%]

    [% IF js_files -%]
      [% FOREACH js_file IN js_files -%]
        <script src="[% js_file %]"></script>
      [% END -%]
    [% END -%]
    [% IF sidebar -%]
      <script type="module" src="/js/lib/navigation.js"></script>
    [% END -%]
    [% INCLUDE partials/global_footer.tt %]
  </body>
</html>
