[% WRAPPER layouts/default.tt %]
<article class="recommender">

  [% IF errors && errors.size > 0 %]
    <div class="recommender-errors">
      <h3 class="spectrum-Heading spectrum-Heading--sizeS">Issues</h3>
      <ul>
        [% FOREACH err IN errors %]
          <li class="spectrum-Body spectrum-Body--sizeS" style="color: var(--spectrum-negative-color-900);">
            [% err %]
          </li>
        [% END %]
      </ul>
    </div>
  [% END %]

  <form method="POST" action="/Searches/Recommender" class="recommender-form">
    <div class="spectrum-Form-item">
      <label for="fic_urls" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">
        AO3 Work URLs (one per line, or comma-separated)
      </label>
      <textarea id="fic_urls" name="fic_urls" rows="4"
        class="spectrum-Textfield spectrum-Textfield--multiline"
        placeholder="https://archiveofourown.org/works/12345678"
      >[% form_urls | html %]</textarea>
    </div>

    <div class="spectrum-Form-item">
      <label for="wait_level" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">
        How long to search (more = better results, but slower)
      </label>
      <select id="wait_level" name="wait_level" class="spectrum-Picker">
        <option value="some" [% IF form_wait == 'some' %]selected[% END %]>Some (~5 min)</option>
        <option value="long" [% IF !form_wait || form_wait == 'long' %]selected[% END %]>Long (~10 min)</option>
        <option value="very long" [% IF form_wait == 'very long' %]selected[% END %]>Very Long (~20+ min)</option>
      </select>
    </div>

    <div class="spectrum-Form-item">
      <label for="blacklist_tags" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">
        Exclude tags (comma-separated, exact match, case-insensitive)
      </label>
      <input type="text" id="blacklist_tags" name="blacklist_tags"
        class="spectrum-Textfield"
        placeholder="e.g. Explicit, Major Character Death"
        value="[% form_blacklist | html %]" />
      <p class="spectrum-Body spectrum-Body--sizeXS">
        Works with any of these tags will be removed from results entirely.
        Use the exact AO3 canonical tag spelling.
      </p>
    </div>

    <div class="spectrum-Form-item">
      <label for="enforce_tags" class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">
        Require tags (comma-separated, exact match, case-insensitive)
      </label>
      <input type="text" id="enforce_tags" name="enforce_tags"
        class="spectrum-Textfield"
        placeholder="e.g. Harry Potter, F/M"
        value="[% form_enforce | html %]" />
    </div>

    <div class="spectrum-Form-item">
      <label class="spectrum-FieldLabel spectrum-FieldLabel--sizeM">
        <input type="checkbox" name="soft_enforcement"
          [% IF !form_soft.defined || form_soft %]checked[% END %] />
        Soft enforcement (boost score instead of hard filter)
      </label>
      <p class="spectrum-Body spectrum-Body--sizeXS">
        When enabled, required tags double the score of matching works
        instead of hiding works that lack them.
      </p>
    </div>

    <button type="submit" class="spectrum-Button spectrum-Button--fill spectrum-Button--accent spectrum-Button--sizeM">
      <span class="spectrum-Button-label">Find Recommendations</span>
    </button>

    <p class="spectrum-Body spectrum-Body--sizeXS" style="margin-top: 1em;">
      This will make many requests to AO3 with rate limiting. Please be patient.
    </p>
  </form>
</article>
[% END %]
