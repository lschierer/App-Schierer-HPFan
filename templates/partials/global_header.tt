<link rel="stylesheet" href="/css/global_header.css" />
<header class="header">
  [%# The mobile drawer, with its opener. <site-drawer> is display:contents, so the opener
      takes part in the header's grid as a direct child would; the panel is a modal <dialog>
      in the top layer. See lib/components/site-drawer.ts.

      The opener's name is constant ("Navigation menu") and aria-expanded carries the state:
      a button that renames itself as well as flipping aria-expanded is announced twice over,
      and while the drawer is open the page behind it, opener included, is inert anyway. -%]
  <site-drawer id="mobile-menu" label="Site navigation" close-label="Close navigation">
    <swc-action-button slot="toggle" quiet class="mobile-menu-button" id="mobile-menu-toggle"
                       accessible-label="Navigation menu" aria-expanded="false">
      <swc-icon slot="icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M3 5h14v2H3zM3 9h14v2H3zM3 13h14v2H3z"/>
        </svg>
      </swc-icon>
    </swc-action-button>
    <nav aria-label="Site navigation">
      [% INCLUDE partials/mobile_navigation.tt %]
    </nav>
  </site-drawer>

  <!-- Logo/Title section -->
  <div class="site-title-section">
    <div class="logo-container">
      <a href="/" class="site-title swc-Link swc-Link--secondary swc-Link--quiet swc-Link--standalone">
        [% IF site_logo -%]
          [% site_logo %]
        [% END -%]
      </a>
    </div>
    <div class="title-container">
      <a href="/" class="site-title swc-Link swc-Link--secondary swc-Link--quiet swc-Link--standalone">
        <span class="site-title swc-Heading">Luke's HP Site</span>
      </a>
    </div>
  </div>

  <!-- Desktop navigation (hidden on mobile) -->
  <nav class="navigation">
    [% FOREACH section IN ['Harrypedia', 'Fan Fiction', 'Searches', 'Bookmarks'] -%]
      <div class="nav-item">
        <a href="/[% section %]" class="swc-Link swc-Link--quiet swc-Link--standalone">
          <span class="swc-Heading swc-Heading--serif swc-Heading--sizeXS">
            [% section %]
          </span>
        </a>
      </div>
    [% END -%]
  </nav>

  <!-- Social icons -->
  <div class="social">
    <div class="social-icon">
      <a class="social-icons nav-item swc-Link swc-Link--quiet swc-Link--standalone" href="https://github.com/lschierer/App-Schierer-HPFan">
        <iconify-icon id="github" class="social-icons nav-item" icon="codicon:github" height="none"></iconify-icon>
      </a>
    </div>
  </div>
</header>
